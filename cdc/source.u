      let c = native.bytes_at(source, at);
      let size = u_choose(native.int_eq(c, 194), fn() => u_choose(native.int_eq(u_cdcsrc_byte(source, native.int_add(at, 1)), 133), fn() => 2, fn() => 0), fn() =>
        u_choose(native.int_eq(c, 226), fn() => u_choose(native.bool_and(native.int_eq(u_cdcsrc_byte(source, native.int_add(at, 1)), 128),
          u_contains([168, 169], u_cdcsrc_byte(source, native.int_add(at, 2)))), fn() => 3, fn() => 0),
          fn() => u_choose(native.bool_and(native.int_eq(c, 13), native.int_eq(u_cdcsrc_byte(source, native.int_add(at, 1)), 10)), fn() => 2, fn() => 1)));
