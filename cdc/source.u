def u_cdcsrc_numeric: Value = ["dt", "gain", "deadband", "belief", "prior", "theta", "omega", "amplitude", "precision", "weight", "angle", "delay"];
def u_cdcsrc_typed(attributes: Value) -> Value = {
  let keys = native.record_keys(attributes);
