    u_choose(u_contains([32, 9, 13, 10], c), fn() => { u_cdcsrc_word_finish(state); native.cell_set(cursor, native.int_add(at, 1)); yield (); }, fn() =>
    u_choose(native.int_eq(c, 35), fn() => { u_cdcsrc_word_finish(state); native.cell_set(cursor, native.bytes_length(line)); yield (); }, fn() =>
    u_choose(u_contains([34, 39], c), fn() => {
