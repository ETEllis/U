def u_cdcsrc_word_finish(state: Value) -> Unit = {
  u_choose(native.cell_get(state.active), fn() => {
    native.buffer_push(state.words, native.text_join(native.buffer_freeze(native.cell_get(state.parts)), ""));
    native.cell_set(state.parts, native.buffer_new()); native.cell_set(state.active, false); yield ();
  }, fn() => ()); yield ();
