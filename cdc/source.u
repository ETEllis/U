def u_cdcsrc_attributes(words: Value) -> Value = {
  let first = native.cell_new(#{}); let last = native.cell_new(#{}); let ordered = native.buffer_new();
  u_for(native.int_sub(native.list_length(words), 2), fn(i: Int) => {
    let word = native.list_get(words, native.int_add(i, 2)); let separator = native.bytes_find(word, "=", 0);
    yield u_choose(native.int_ge(separator, 0), fn() => {
      let key = native.bytes_slice(word, 0, separator); let value = native.bytes_slice(word, native.int_add(separator, 1), native.bytes_length(word));
      native.buffer_push(ordered, [key, value]);
      u_choose(native.record_has(native.cell_get(first), key), fn() => (), fn() => native.cell_set(first, native.record_put(native.cell_get(first), key, value)));
      native.cell_set(last, native.record_put(native.cell_get(last), key, value)); yield ();
