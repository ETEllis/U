def u_cdcsrc_close(actual: Real, expected: Text, tolerance: Real) -> Unit = {
  let value = u_cdcsrc_number(expected);
  u_require(native.f64_le(native.math_abs(u_real_sub(actual, value)), tolerance), "CDC post-step expectation mismatch"); yield ();
};
def u_cdcsrc_expect(result: Value, attributes: Value) -> Unit = {
  let tolerance = u_cdcsrc_number(u_get(attributes, "tolerance", "0.000001"));
  u_require(native.f64_ge(tolerance, 0.0), "invalid expectation tolerance");
  u_choose(native.record_has(attributes, "expect-theta"), fn() => {
    let expectation = native.record_get(attributes, "expect-theta");
    let last = native.cell_new(-1); let cursor = native.cell_new(0);
    native.control_while(fn() => native.int_lt(native.cell_get(cursor), native.bytes_length(expectation)), fn() => {
      let next = native.bytes_find(expectation, ":", native.cell_get(cursor));
      u_choose(native.int_ge(next, 0), fn() => { native.cell_set(last, next); native.cell_set(cursor, native.int_add(next, 1)); yield (); },
        fn() => native.cell_set(cursor, native.bytes_length(expectation))); yield ();
    });
    u_require(native.int_ge(native.cell_get(last), 0), "CDC expect-theta requires cell:value");
    let name = native.bytes_slice(expectation, 0, native.cell_get(last));
    let value = native.bytes_slice(expectation, native.int_add(native.cell_get(last), 1), native.bytes_length(expectation));
    u_cdcsrc_close(u_cdc_named(result.state.cells, name).theta, value, tolerance); yield ();
  }, fn() => ());
  u_map([#{key: "expect-parent-belief", field: "parent_belief"}, #{key: "expect-child-prior", field: "child_prior"}], fn(pair: Value) =>
    u_choose(native.record_has(attributes, pair.key), fn() => u_cdcsrc_close(native.record_get(result, pair.field), native.record_get(attributes, pair.key), tolerance), fn() => ()));
  u_map([#{key: "expect-status", field: "status"}, #{key: "expect-reason", field: "reason"}, #{key: "expect-balance", field: "balance"}], fn(pair: Value) =>
    u_choose(native.record_has(attributes, pair.key), fn() => u_require(native.text_eq(native.record_get(attributes, pair.key), native.record_get(result, pair.field)),
      native.text_concat("CDC post-step mismatch: ", pair.key)), fn() => ()));
  u_choose(native.record_has(attributes, "expect-trits"), fn() => {
    let trits = native.text_join(u_map(result.trits, fn(value: Int) =>
      u_choose(native.int_eq(value, 1), fn() => "+", fn() => u_choose(native.int_eq(value, -1), fn() => "-", fn() => "0"))), "");
    u_require(native.text_eq(trits, native.record_get(attributes, "expect-trits")), "CDC post-step trit mismatch"); yield ();
  }, fn() => ()); yield ();
};
def u_cdc_execute_source_budget(source: Text, budget: Nat) -> Value = {
  let program = u_cdc_parse(source);
  yield u_choose(native.int_gt(native.list_length(program.unsupported), 0), fn() =>
    #{verdict: "Unsupported", obligations: program.unsupported, source_identity: program.source_identity, state: program.state, profile: program.profile}, fn() => {
    let state = native.cell_new(program.state); let trace = native.buffer_new(); let index = native.cell_new(0); let failure = native.cell_new(());
    native.control_while(fn() => native.bool_and(native.text_eq(native.value_kind(native.cell_get(failure)), "unit"),
      native.bool_and(native.int_lt(native.cell_get(index), native.list_length(program.steps)), native.int_lt(native.cell_get(index), budget))), fn() => {
      let step = native.list_get(program.steps, native.cell_get(index)); let attrs = step.attrs;
      let attempted = native.value_try_call(fn() =>
        u_choose(native.text_eq(step.kind, "flow"), fn() => u_cdc_flow(native.cell_get(state), native.record_get(attrs, "field"), u_cdcsrc_number(native.record_get(attrs, "duration"))),
          fn() => u_choose(native.text_eq(step.kind, "commit"), fn() => u_cdc_commit(native.cell_get(state), native.record_get(attrs, "module")),
            fn() => u_cdc_nest(native.cell_get(state), native.record_get(attrs, "parent"), native.record_get(attrs, "child")))), []);
      u_choose(attempted.ok, fn() => {
        let result = attempted.value; native.cell_set(state, result.state);
        native.buffer_push(trace, native.record_put(result, "step", step.name));
        native.cell_set(index, native.int_add(native.cell_get(index), 1));
        let expected = native.value_try_call(fn() => u_cdcsrc_expect(result, attrs), []);
        u_choose(expected.ok, fn() => (), fn() => native.cell_set(failure, #{reason: expected.message, code: expected.code})); yield ();
      }, fn() => native.cell_set(failure, #{reason: attempted.message, code: attempted.code})); yield ();
    });
    let result = #{state: native.cell_get(state), trace: native.buffer_freeze(trace), profile: program.profile,
      source_identity: program.source_identity, known_progress: native.cell_get(index)};
    yield u_choose(native.text_eq(native.value_kind(native.cell_get(failure)), "record"), fn() =>
      native.record_put(native.record_put(native.record_put(result, "verdict", "Fault"), "reason", native.cell_get(failure).reason), "code", native.cell_get(failure).code), fn() =>
      u_choose(native.int_lt(native.cell_get(index), native.list_length(program.steps)),
        fn() => native.record_put(native.record_put(result, "verdict", "Held"), "reason", "execution-budget"),
        fn() => native.record_put(result, "verdict", "Done")));
  });
};
def u_cdc_execute_source(source: Text) -> Value = u_cdc_execute_source_budget(source, 100000);
def cdc_source: Value = #{parse: u_cdc_parse, execute: u_cdc_execute_source, execute_budget: u_cdc_execute_source_budget};
