def u_cdc_parse(source: Text) -> Value = {
  u_require(native.int_le(native.bytes_length(source), 2000000), "CDC source exceeds the two-million-byte profile limit");
  let fields = native.buffer_new(); let modules = native.buffer_new(); let cells = native.buffer_new(); let channels = native.buffer_new();
  let statements = native.buffer_new(); let steps = native.buffer_new(); let unsupported = native.buffer_new();
  let groups = #{field: fields, module: modules, cell: cells};
  u_map(u_cdcsrc_lines(source), fn(line: Value) => {
    let words = u_cdcsrc_words(line.text, line.number);
    yield u_choose(native.int_eq(native.list_length(words), 0), fn() => (), fn() => {
      u_choose(native.int_ge(native.list_length(words), 2), fn() => (), fn() => u_cdcsrc_error(line.number, "missing identifier"));
      let kind = native.list_get(words, 0); let name = native.list_get(words, 1); let attributes = u_cdcsrc_attributes(words);
      native.buffer_push(statements, #{line: line.number, kind: kind, name: name,
        ordered_attributes: attributes.ordered, native_first: attributes.first, registry_last: attributes.last});
      let typed = u_cdcsrc_typed(attributes.first);
      yield u_choose(native.record_has(groups, kind), fn() => native.buffer_push(native.record_get(groups, kind), native.record_put(typed, "name", name)), fn() =>
      u_choose(native.text_eq(kind, "channel"), fn() => {
        u_choose(native.int_ge(native.list_length(words), 4), fn() => (), fn() => u_cdcsrc_error(line.number, "channel requires source -> target"));
        u_choose(native.text_eq(native.list_get(words, 2), "->"), fn() => (), fn() => u_cdcsrc_error(line.number, "channel requires source -> target"));
        yield native.buffer_push(channels, native.record_put(native.record_put(typed, "source", name), "target", native.list_get(words, 3)));
      }, fn() => u_choose(u_contains(["flow", "commit", "nest"], kind),
        fn() => native.buffer_push(steps, #{kind: kind, name: name, attrs: attributes.first}),
        fn() => native.buffer_push(unsupported, #{line: line.number, directive: kind, status: "residual-preserved, unsupported native import"}))));
    });
  });
  let state = u_cdc_make_state(#{fields: native.buffer_freeze(fields), modules: native.buffer_freeze(modules),
    cells: native.buffer_freeze(cells), channels: native.buffer_freeze(channels)});
  yield #{state: state, steps: native.buffer_freeze(steps), statements: native.buffer_freeze(statements), residual: source,
    source_identity: native.text_concat("sha256:", native.crypto_sha256(source)), profile: u_cdc_source_profile,
    unsupported: native.buffer_freeze(unsupported)};
